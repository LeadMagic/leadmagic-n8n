{
  "name": "n8n-nodes-leadmagic",
  "version": "1.5.0",
  "description": "LeadMagic n8n community node for email, people, company, jobs, and advertising enrichment.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "leadmagic",
    "lead-enrichment",
    "email-finder",
    "b2b-data",
    "data-enrichment",
    "lead-generation",
    "email-validation",
    "company-intelligence",
    "profile-enrichment",
    "job-intelligence",
    "advertisement-tracking",
    "professional-enrichment",
    "sales-intelligence",
    "technographics",
    "job-change-detection",
    "competitor-analysis",
    "ai-agent-tool"
  ],
  "license": "MIT",
  "homepage": "https://github.com/LeadMagic/leadmagic-n8n",
  "author": {
    "name": "LeadMagic",
    "email": "support@leadmagic.io",
    "url": "https://leadmagic.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeadMagic/leadmagic-n8n.git"
  },
  "bugs": {
    "url": "https://github.com/LeadMagic/leadmagic-n8n/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build && node scripts/copy-metadata.cjs",
    "dev": "n8n-node dev",
    "format": "prettier nodes credentials --write",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm check:package",
    "test": "npm run build && node --test tests/*.test.cjs",
    "check:package": "node scripts/check-package.cjs"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/LeadMagicApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/LeadMagic/LeadMagic.node.js"
    ],
    "strict": true
  },
  "devDependencies": {
    "@n8n/node-cli": "0.46.4",
    "eslint": "9.29.0",
    "n8n-workflow": "^2.16.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "pnpm": {
    "overrides": {
      "form-data": "^4.0.6",
      "qs": "^6.16.0"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.33.0"
}
