          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ Number($json.similarity) }}",
              "rightValue": "={{ $('Seed customers').first().json.min_similarity }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e5cee57b-ef12-5e44-93b9-5cf4effd4466",
