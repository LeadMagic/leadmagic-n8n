          "min_employees": "={{ $json.min_employees }}",
          "max_employees": "={{ $json.max_employees }}"
        },
        "limit": "={{ $json.accounts }}"
      },
      "id": "7230b2ed-c726-5772-976c-9d9ccfac63e6",
      "name": "Companies using it",
