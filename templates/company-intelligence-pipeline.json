    {
      "parameters": {
        "jsCode": "/*\n * Compile comprehensive company intelligence report\n */\n\nconst domain = $('📝 Input: Company Domain').first().json.domain;\nconst companyInfo = $('🏢 Get Company Info').first().json || {};\nconst fundingInfo = $('💰 Get Funding Data').first().json || {};\nconst ceoInfo = $('👔 Find CEO').first().json || {};\nconst ctoInfo = $('💻 Find CTO').first().json || {};\nconst marketingInfo = $('📢 Find VP Marketing').first().json || {};\nconst googleAds = $('📱 Google Ads Intel').first().json || {};\nconst metaAds = $('📘 Meta Ads Intel').first().json || {};\n\n// Helper to extract person data\nconst extractPerson = (data) => ({\n  name: data.full_name || `${data.first_name || ''} ${data.last_name || ''}`.trim() || 'Not found',\n  email: data.email || '',\n  linkedin: data.profile_url || data.linkedin_url || '',\n  title: data.job_title || data.title || ''\n});\n\nreturn {\n  company: {\n    domain: domain,\n    name: companyInfo.name || companyInfo.company_name || domain.split('.')[0],\n    industry: companyInfo.industry || 'Unknown',\n    employees: companyInfo.employeesCount || companyInfo.employee_count,\n    location: companyInfo.hq || companyInfo.location,\n    founded: companyInfo.founded_year,\n    description: companyInfo.shortDescription || companyInfo.description,\n    linkedin_url: companyInfo.linkedin_url\n  },\n  funding: {\n    total_raised: fundingInfo.total_funding || fundingInfo.funding_metrics?.total || 0,\n    last_round: fundingInfo.last_round || fundingInfo.funding_metrics?.latest,\n    last_amount: fundingInfo.last_amount,\n    stage: fundingInfo.stage,\n    investors: (fundingInfo.investors || []).slice(0, 10),\n    valuation: fundingInfo.valuation\n  },\n  leadership: {\n    ceo: extractPerson(ceoInfo),\n    cto: extractPerson(ctoInfo),\n    vp_marketing: extractPerson(marketingInfo)\n  },\n  advertising: {\n    google_ads: {\n      active: !!(googleAds.ads?.length || googleAds.count),\n      count: googleAds.ads?.length || googleAds.count || 0,\n      keywords: googleAds.keywords || [],\n      ad_samples: (googleAds.ads || []).slice(0, 3)\n    },\n    meta_ads: {\n      active: !!(metaAds.ads?.length || metaAds.count),\n      count: metaAds.ads?.length || metaAds.count || 0,\n      ad_samples: (metaAds.ads || []).slice(0, 3)\n    }\n  },\n  meta: {\n    researched_at: new Date().toISOString(),\n    credits_used: null,\n    data_sources: [\n      'company_search', 'funding_data', \n      'ceo_lookup', 'cto_lookup', 'vp_marketing_lookup',\n      'google_ads', 'meta_ads'\n    ]\n  }\n};"
      },
