    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a B2B marketing analyst. Summarize these competitors' current ads for a sales and marketing team.\nFor each competitor: main messages, offers or CTAs, and audiences targeted. Then list 3 cross-competitor themes and 2 ideas for our positioning.\nBe concise and only use the data provided.\n\n{{ JSON.stringify($json.competitors) }}",
        "hasOutputParser": false
      },
